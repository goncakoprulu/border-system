{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Cors": {
    "AllowedOrigins": "http://localhost:3000"
  },
  "Security": {
    "UseHttpsRedirection": false,
    "RequireSecureCookies": false,
    "UseHsts": false
  },
  "Database": {
    "ApplyMigrationsOnStartup": true,
    "ForceTls12": false
  }
}
