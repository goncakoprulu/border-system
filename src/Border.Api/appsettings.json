{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Security": {
    "UseHttpsRedirection": true,
    "RequireSecureCookies": false,
    "UseHsts": false
  },
  "DataProtection": {
    "KeyPath": ""
  },
  "Database": {
    "ApplyMigrationsOnStartup": false,
    "ForceTls12": false
  },
  "ReverseProxy": {
    "Enabled": false,
    "KnownProxies": []
  },
  "AllowedHosts": "*"
}
